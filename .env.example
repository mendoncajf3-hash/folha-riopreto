# ═══════════════════════════════════════════════════════════════
# Variáveis de ambiente — Sistemas legados (server.js / server_riopreto.js)
# Copie para .env e preencha. O .env NUNCA vai para o git (ver .gitignore).
# ═══════════════════════════════════════════════════════════════

# Segredo de sessão (gere com: openssl rand -hex 48)
SESSION_SECRET=

# Chave do Google AI / Gemini (gere nova no console.cloud.google.com)
GOOGLE_AI_KEY=

# Senhas iniciais dos usuários (apenas para o primeiro boot do sistema).
# Após o primeiro acesso, troque pelo painel. Deixe em branco para gerar
# senha aleatória (server_riopreto.js) — depois use recuperação de senha.
SEED_PWD_JEFFERSON=
SEED_PWD_DANIEL=
SEED_PWD_FERNANDO=
SEED_PWD_LUAN=
