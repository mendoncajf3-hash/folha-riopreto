# Copie para .env e ajuste conforme o ambiente.
NODE_ENV=development
PORT=3333
# Conexão PostgreSQL
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_dev?schema=public"
# Segredos JWT — GERE valores fortes e únicos em produção (openssl rand -hex 32)
JWT_ACCESS_SECRET="dev-access-secret-troque-em-producao"
JWT_REFRESH_SECRET="dev-refresh-secret-troque-em-producao"
ACCESS_TOKEN_TTL="15m"
REFRESH_TOKEN_TTL_DAYS=7
# Origem do front-end (CORS)
WEB_ORIGIN="http://localhost:5173"
# Credenciais do admin inicial (usadas apenas no seed)
SEED_ADMIN_EMAIL="admin@portal.local"
SEED_ADMIN_PASSWORD="Admin@123"
SEED_ADMIN_NAME="Administrador"
